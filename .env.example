# Bu dosyayı ASLA repoya commit etmeyin (.gitignore içinde .env zaten hariç tutulur).

# Gemini API anahtarı — özetleme + önem skorlama için VARSAYILAN sağlayıcı
# (config.yaml > summarizer.llm_provider: gemini). Google AI Studio'dan
# ücretsiz alınır: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic (Claude) API anahtarı — yalnızca config.yaml > summarizer.llm_provider
# değerini "anthropic" yaparsanız gereklidir. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NewsAPI.ai (Event Registry) API anahtarı — Reuters/Bloomberg finans
# haberlerine LİSANSLI/RESMİ erişim için kullanılır (scraping değildir).
# Ücretsiz hesap: https://www.newsapi.ai/register -> Dashboard -> API Key
# Bu değer boş/tanımsız bırakılırsa ilgili kaynak sessizce atlanır, program
# çökmez (bkz. README > "Lisanslı Kaynak: Reuters/Bloomberg (NewsAPI.ai)").
EVENTREGISTRY_API_KEY=

# Telegram bildirimleri için: BotFather'dan bot token'ı, chat_id'nizi ise
# getUpdates ile alın (adım adım talimatlar için README > "Telegram Bildirimi"
# bölümüne bakın). Her ikisi de boş/tanımsız bırakılırsa bildirim adımı
# sessizce (loglayarak) atlanır, program çökmez.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
